# The Order window, for a Matron holding a Matronate and for the High Matriarch. Two tabs:
#   Flock: the Aeluran rulers in her care, each with the Red Sister who advises them; an open post she may fill shows
#          an Assign button (Appoint an Advisor).
#   Bloodlines: the unwed noble elves in her care, the worthiest first; choose two and propose the match.
#   Sisters: the Order's Sisters in her care, with the tithe each sends her from the temples she holds in lease and a
#            mark on those who sit a ruler's council as its Red Sister.
# The lists are built by scripted guis (aeluran_order_refresh, aeluran_bl_refresh,
# aeluran_order_sisters_refresh) when the window or a tab opens.
# The selected tab is the GUI variable aeluran_order_tab ('bloodlines', 'sisters', or unset for the Flock).
window = {
	name = "aeluran_order_window"
	parentanchor = center
	size = { 1250 940 }
	layer = middle
	allow_outside = yes
	movable = yes
	visible = "[GetVariableSystem.Exists( 'aeluran_order_window' )]"

	using = Window_Background
	using = Window_Decoration_Spike

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}

	vbox = {
		using = Window_Margins
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "AELURAN_ORDER_WINDOW_TITLE"
			}
			blockoverride "button_close" {
				onclick = "[GetVariableSystem.Clear( 'aeluran_order_window' )]"
			}
		}

		# Tabs
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 4 }
			spacing = 8

			button_standard = {
				size = { 270 36 }
				text = "AELURAN_ORDER_TAB_FLOCK"
				onclick = "[GetScriptedGui( 'aeluran_order_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Clear( 'aeluran_order_tab' )]"
			}
			button_standard = {
				size = { 270 36 }
				text = "AELURAN_ORDER_TAB_BLOODLINES"
				onclick = "[GetScriptedGui( 'aeluran_bl_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Set( 'aeluran_order_tab', 'bloodlines' )]"
			}
			button_standard = {
				size = { 270 36 }
				text = "AELURAN_ORDER_TAB_SISTERS"
				onclick = "[GetScriptedGui( 'aeluran_order_sisters_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Set( 'aeluran_order_tab', 'sisters' )]"
			}
			expand = {}
		}

		##########
		# Flock  #
		##########
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[Not( GetVariableSystem.Exists( 'aeluran_order_tab' ) )]"

			text_single = {
				layoutpolicy_horizontal = expanding
				margin = { 15 6 }
				text = "AELURAN_ORDER_FLOCK_PIETY"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content" {
					vbox = {
						name = "aeluran_order_flock_list"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList( 'aeluran_order_flock' )]"

						item = {
							widget = {
								size = { 840 150 }
								datacontext = "[Scope.GetCharacter]"

								background = {
									using = Background_Area
								}

								# The ruler
								portrait_head_small = {
									position = { 50 3 }
								}
								text_single = {
									position = { 146 4 }
									text = "[Character.GetShortUIName]"
									using = Font_Size_Medium
								}
								text_single = {
									position = { 146 30 }
									text = "[Character.GetPrimaryTitle.GetNameNoTooltip]"
								}
								text_single = {
									position = { 146 50 }
									text = "AELURAN_ORDER_ROW_DEVOTION"
								}
								# Her realm's Aeluran Realm Authority law
								icon = {
									position = { 146 70 }
									size = { 22 22 }
									texture = "[Character.GetActiveLawInGroupWithFlag( 'aeluran_realm_authority' ).GetIcon]"
									visible = "[GetScriptedGui( 'aeluran_order_has_realm_authority' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
								}
								text_single = {
									position = { 172 72 }
									text = "AELURAN_ORDER_ROW_AUTHORITY"
									tooltip = "[Character.GetActiveLawInGroupWithFlag( 'aeluran_realm_authority' ).GetEffectDescription]"
								}

								# Spouses: a half-size portrait per spouse (var list aeluran_order_spouses, from aeluran_order_refresh),
								# then an empty one per unused spouse slot. flowcontainers pack from the top left: an hbox here stretched to the
								# whole row, centring the portraits and pushing the empty slots far right
								flowcontainer = {
									position = { 146 96 }
									spacing = 2

									flowcontainer = {
										datamodel = "[Character.MakeScope.GetList( 'aeluran_order_spouses' )]"
										spacing = 2

										# A small portrait built at its own size (scale would also shrink its position)
										item = {
											widget = {
												size = { 46 50 }
												datacontext = "[Scope.GetCharacter]"

												background = {
													texture = "gfx/portraits/portrait_frame.dds"
													using = Color_Grey
													alpha = 0.4
												}
												portrait_button = {
													parentanchor = bottom|hcenter
													size = { 44 55 }
													using = portrait_base
													portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
													mask = "gfx/portraits/portrait_mask_head_small.dds"
													effectname = "NoHighlight"
												}
											}
										}
									}

									flowcontainer = {
										datamodel = "[GetNullCharacterDataModel( Character.CalcUnusedSpouseSlots )]"
										spacing = 2

										item = {
											widget = {
												size = { 46 50 }
												tooltip = "AELURAN_ORDER_EMPTY_SPOUSE_SLOT"

												background = {
													texture = "gfx/portraits/portrait_frame.dds"
													using = Color_Grey
													alpha = 0.4
												}
												icon = {
													parentanchor = bottom|hcenter
													size = { 40 50 }
													texture = "gfx/portraits/unknown_portraits/button_unknown_head.dds"
													framesize = { 384 480 }
													frame = 1
													alpha = 0.6
												}
											}
										}
									}
								}

								# Religious interactions with the ruler (vanilla type, gui/window_faith.gui)
								button_interactions_religion = {
									parentanchor = left|vcenter
									position = { 4 0 }
								}

								# Her Red Sister, or an open post
								widget = {
									position = { 520 0 }
									size = { 110 96 }

									# visible sits on the wrapper, in the ruler's context; the portrait reads the list item (Scope, the ruler), not
									# Character, which inside its own datacontext is the Sister herself
									widget = {
										size = { 110 96 }
										visible = "[Character.MakeScope.Var( 'aeluran_order_red_sister' ).IsSet]"

										portrait_head_small = {
											position = { 10 3 }
											datacontext = "[Scope.Var( 'aeluran_order_red_sister' ).GetCharacter]"
										}
									}

									button_standard = {
										parentanchor = center
										size = { 100 40 }
										text = "AELURAN_ORDER_ASSIGN"
										tooltip = "AELURAN_ORDER_ASSIGN_TT"
										visible = "[GetScriptedGui( 'aeluran_order_post_is_open' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
										onclick = "[GetScriptedGui( 'aeluran_order_open_appoint' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
									}

									text_single = {
										parentanchor = center
										text = "AELURAN_ORDER_NO_ADVISOR"
										visible = "[And( Not( Character.MakeScope.Var( 'aeluran_order_red_sister' ).IsSet ), Not( GetScriptedGui( 'aeluran_order_post_is_open' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End ) ) )]"
									}
								}

								# The ruler and the Red Sister: the ruler's opinion of her, and their relationships
								widget = {
									position = { 630 0 }
									size = { 150 96 }
									visible = "[Character.MakeScope.Var( 'aeluran_order_red_sister' ).IsSet]"

									text_single = {
										position = { 0 20 }
										text = "AELURAN_ORDER_RS_OPINION"
										tooltip = "[Character.GetOpinionBreakdownText( Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
									}

									hbox = {
										position = { 0 50 }
										spacing = 2
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/marriage.dds"
												visible = "[GetScriptedGui( 'aeluran_order_is_spouse' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).AddScope( 'target', Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter.MakeScope ).End )]"
												tooltip = "AELURAN_ORDER_RS_SPOUSE"
											}
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/soulmate.dds"
												visible = "[GetScriptedRelation( 'soulmate' ).HasRelationBetween( Character.Self, Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
												tooltip = "[GetScriptedRelation( 'soulmate' ).GetName]"
											}
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/lover.dds"
												visible = "[GetScriptedRelation( 'lover' ).HasRelationBetween( Character.Self, Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
												tooltip = "[GetScriptedRelation( 'lover' ).GetName]"
											}
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/best_friend.dds"
												visible = "[GetScriptedRelation( 'best_friend' ).HasRelationBetween( Character.Self, Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
												tooltip = "[GetScriptedRelation( 'best_friend' ).GetName]"
											}
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/friend.dds"
												visible = "[GetScriptedRelation( 'friend' ).HasRelationBetween( Character.Self, Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
												tooltip = "[GetScriptedRelation( 'friend' ).GetName]"
											}
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/nemesis.dds"
												visible = "[GetScriptedRelation( 'nemesis' ).HasRelationBetween( Character.Self, Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
												tooltip = "[GetScriptedRelation( 'nemesis' ).GetName]"
											}
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/rival.dds"
												visible = "[GetScriptedRelation( 'rival' ).HasRelationBetween( Character.Self, Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
												tooltip = "[GetScriptedRelation( 'rival' ).GetName]"
											}
											icon = {
												size = { 28 28 }
												texture = "gfx/interface/icons/memory_types/grudge.dds"
												visible = "[GetScriptedRelation( 'grudge' ).HasRelationBetween( Character.Self, Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter )]"
												tooltip = "[GetScriptedRelation( 'grudge' ).GetName]"
											}
									}
								}

								# Gather Whispers with the ruler's Red Sister, right of her portrait (as on the Sisters tab)
								button_round = {
									position = { 790 26 }
									visible = "[Character.MakeScope.Var( 'aeluran_order_red_sister' ).IsSet]"
									enabled = "[Not( Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter.MakeScope.Var( 'aeluran_whispers_for' ).IsSet )]"
									tooltip = "AELURAN_ORDER_FLOCK_WHISPERS_TT"
									onclick = "[GetScriptedGui( 'aeluran_order_open_whispers' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope.Var( 'aeluran_order_red_sister' ).GetCharacter.MakeScope ).End )]"

									icon = {
										alwaystransparent = yes
										parentanchor = center
										size = { 34 34 }
										texture = "gfx/interface/icons/council_task_types/task_find_secrets.dds"
									}
								}
							}
						}
					}
				}
			}
		}

		###############
		# Matchmaking #
		###############
		# Left: the nobles in her care with room for a spouse (aeluran_bloodlines). Choose one, and the right side lists
		# the matches for them (aeluran_bl_matches), each with Propose. Lists from aeluran_bl_refresh / aeluran_bl_choose.
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[GetVariableSystem.HasValue( 'aeluran_order_tab', 'bloodlines' )]"

			# Propose Match: your portrait, the chosen noble, the button, the selected match, and the match's Matron
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 0 8 }
				spacing = 14
			
				expand = {}
			
								vbox = {
					spacing = 4
					widget = {
						size = { 55 60 }
						tooltip = "AELURAN_BL_PANEL_YOU_TT"
				
						background = {
							texture = "gfx/portraits/portrait_frame.dds"
							using = Color_Grey
							alpha = 0.5
						}
						widget = {
							size = { 55 60 }
							visible = "[GetPlayer.IsValid]"
							portrait_button = {
								parentanchor = bottom|hcenter
								size = { 53 66 }
								datacontext = "[GetPlayer]"
								using = portrait_base
								portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
								mask = "gfx/portraits/portrait_mask_head_small.dds"
								effectname = "NoHighlight"
							}
						}
						icon = {
							parentanchor = bottom|hcenter
							size = { 47 60 }
							visible = "[Not( GetPlayer.IsValid )]"
							texture = "gfx/portraits/unknown_portraits/button_unknown_head.dds"
							framesize = { 384 480 }
							frame = 1
							alpha = 0.5
						}
					}
					# Their liege, as large as the Matron above; none when they are their own ruler (an independent ruler's liege is
					# themselves)
					widget = {
						size = { 55 60 }
						tooltip = "AELURAN_BL_PANEL_FIRST_LIEGE_TT"
						visible = "[And( GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter.GetLiege.IsValid, Not( ObjectsEqual( GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter.GetLiege, GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter ) ) )]"
					
						background = {
							texture = "gfx/portraits/portrait_frame.dds"
							using = Color_Grey
							alpha = 0.5
						}
						portrait_button = {
							parentanchor = bottom|hcenter
							size = { 53 66 }
							datacontext = "[GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter.GetLiege]"
							using = portrait_base
							portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							mask = "gfx/portraits/portrait_mask_head_small.dds"
							effectname = "NoHighlight"
						}
					}
				}
				# The chosen noble
				widget = {
					size = { 110 120 }
					tooltip = "AELURAN_BL_PANEL_FIRST_TT"
			
					background = {
						texture = "gfx/portraits/portrait_frame.dds"
						using = Color_Grey
						alpha = 0.5
					}
					widget = {
						size = { 110 120 }
						visible = "[GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).IsSet]"
						portrait_button = {
							parentanchor = bottom|hcenter
							size = { 108 126 }
							datacontext = "[GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter]"
							using = portrait_base
							portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							mask = "gfx/portraits/portrait_mask_head_small.dds"
							effectname = "NoHighlight"
						}
					}
					icon = {
						parentanchor = bottom|hcenter
						size = { 102 120 }
						visible = "[Not( GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).IsSet )]"
						texture = "gfx/portraits/unknown_portraits/button_unknown_head.dds"
						framesize = { 384 480 }
						frame = 1
						alpha = 0.5
					}
				}
				# Centre: what the match would bring (congenital traits, marriage type), the button, and the matrilineal toggle
				vbox = {
					spacing = 4
					minimumsize = { 280 185 }

					expand = {}
				
					# Congenital traits the children could inherit (as the Arrange Marriage window shows them): the noble's, then the
					# match's that the noble lacks. A check marks a trait both have (reinforced). Vanilla's MatchOffer, which also knows
					# upgrades, exists only inside its marriage window, so this is built from the two characters' traits.
					vbox = {
						visible = "[And( GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).IsSet, GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).IsSet )]"
						spacing = 6
						text_single = {
							text = "INHERITABLE_TRAITS"
							default_format = "#low"
						}
						flowcontainer = {
							spacing = 2
							ignoreinvisible = yes
							flowcontainer = {
								datamodel = "[GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter.GetTraitsForCharacter]"
								ignoreinvisible = yes
								spacing = 2
								item = {
									container = {
										datacontext = "[GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter]"
										visible = "[And( Trait.IsValid, Or( Trait.IsGenetic, Trait.IsInheritable ) )]"
										icon_trait = {
											blockoverride "icon_size" { size = { 34 34 } }
											# Both parents have it: an upgrade arrow when the child could get the next tier (a tiered genetic trait below
											# its group's top tier, as the Arrange Marriage window shows), otherwise the reinforced check
											highlight_icon = {
												visible = "[And( GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).GetCharacter.HasTrait( Trait.Self ), And( Trait.HasTraitGroup, Not( Or( Or( Or( Or( Or( Or( Or( Or( EqualTo_string( Trait.GetKey, 'beauty_good_4' ), EqualTo_string( Trait.GetKey, 'intellect_good_4' ) ), EqualTo_string( Trait.GetKey, 'physique_good_4' ) ), EqualTo_string( Trait.GetKey, 'beauty_bad_3' ) ), EqualTo_string( Trait.GetKey, 'intellect_bad_3' ) ), EqualTo_string( Trait.GetKey, 'physique_bad_3' ) ), EqualTo_string( Trait.GetKey, 'exotic_beauty_good_3' ) ), EqualTo_string( Trait.GetKey, 'unconventional_beauty_good_3' ) ), EqualTo_string( Trait.GetKey, 'magic_talent_3' ) ) ) ) )]"
												position = { 14 12 }
												size = { 24 24 }
												texture = "gfx/interface/icons/symbols/icon_arrow_green_down.dds"
												mirror = vertical
											}
											highlight_icon = {
												visible = "[And( GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).GetCharacter.HasTrait( Trait.Self ), Not( And( Trait.HasTraitGroup, Not( Or( Or( Or( Or( Or( Or( Or( Or( EqualTo_string( Trait.GetKey, 'beauty_good_4' ), EqualTo_string( Trait.GetKey, 'intellect_good_4' ) ), EqualTo_string( Trait.GetKey, 'physique_good_4' ) ), EqualTo_string( Trait.GetKey, 'beauty_bad_3' ) ), EqualTo_string( Trait.GetKey, 'intellect_bad_3' ) ), EqualTo_string( Trait.GetKey, 'physique_bad_3' ) ), EqualTo_string( Trait.GetKey, 'exotic_beauty_good_3' ) ), EqualTo_string( Trait.GetKey, 'unconventional_beauty_good_3' ) ), EqualTo_string( Trait.GetKey, 'magic_talent_3' ) ) ) ) ) )]"
												position = { 14 14 }
												size = { 24 24 }
												texture = "gfx/interface/icons/symbols/icon_check.dds"
											}
										}
									}
								}
							}
							flowcontainer = {
								datamodel = "[GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).GetCharacter.GetTraitsForCharacter]"
								ignoreinvisible = yes
								spacing = 2
								item = {
									container = {
										datacontext = "[GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).GetCharacter]"
										visible = "[And( And( Trait.IsValid, Or( Trait.IsGenetic, Trait.IsInheritable ) ), Not( GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter.HasTrait( Trait.Self ) ) )]"
										icon_trait = {
											blockoverride "icon_size" { size = { 34 34 } }
										}
									}
								}
							}
						}
					}
				
					# Marriage type: whose house the children are born into
					hbox = {
						visible = "[And( GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).IsSet, GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).IsSet )]"
						spacing = 6
						icon = {
							size = { 36 36 }
							texture = "gfx/interface/icons/marriage_types.dds"
							framesize = { 60 60 }
							frame = "[BoolTo1And2( GetScriptedGui( 'aeluran_bl_is_matrilineal' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
						}
						text_single = {
							text = "AELURAN_BL_CHILDREN_HOUSE"
						}
					}
				
					button_standard = {
						size = { 150 40 }
						text = "AELURAN_BL_PROPOSE"
						enabled = "[And( GetScriptedGui( 'aeluran_bl_propose' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( GetScriptedGui( 'aeluran_bl_side_accepts' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_a' ).GetCharacter.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_a' ).GetCharacter.MakeScope ).AddScope( 'secondary_recipient', GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_b' ).GetCharacter.MakeScope ).AddScope( 'puppet_or_actor', GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_b' ).GetCharacter.MakeScope ).AddScope( 'secondary_actor', GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).GetCharacter.MakeScope ).AddScope( 'mm_shepherd', GetPlayer.MakeScope ).AddScope( 'mm_matron', GetPlayer.MakeScope ).End ), GetScriptedGui( 'aeluran_bl_side_accepts' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_b' ).GetCharacter.MakeScope ).AddScope( 'recipient', GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_b' ).GetCharacter.MakeScope ).AddScope( 'secondary_recipient', GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).GetCharacter.MakeScope ).AddScope( 'actor', GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_a' ).GetCharacter.MakeScope ).AddScope( 'puppet_or_actor', GetPlayer.MakeScope.Var( 'aeluran_bl_guardian_a' ).GetCharacter.MakeScope ).AddScope( 'secondary_actor', GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).GetCharacter.MakeScope ).AddScope( 'mm_shepherd', GetPlayer.MakeScope ).AddScope( 'mm_matron', GetPlayer.MakeScope.Var( 'aeluran_bl_match_matron' ).GetCharacter.MakeScope ).End ) ) )]"
