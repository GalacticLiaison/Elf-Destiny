# The Order window, for a Matron holding a Matronate and for the High Matriarch. Two tabs:
#   Flock: the Aeluran rulers in her care, each with the Red Sister who advises them; an open post she may fill shows
#          an Assign button (Appoint an Advisor).
#   Bloodlines: the unwed noble elves in her care, the worthiest first; choose two and propose the match.
#   Sisters: the Order's Sisters in her care, with the tithe each sends her from the temples she holds in lease and a
#            mark on those who sit a ruler's council as its Red Sister.
# The lists are built by scripted guis (aeluran_order_refresh, aeluran_bl_refresh,
# aeluran_order_sisters_refresh) when the window or a tab opens.
# The selected tab is the GUI variable aeluran_order_tab ('bloodlines', 'sisters', or unset for the Flock).
window = {
	name = "aeluran_order_window"
	parentanchor = center
	size = { 660 760 }
	layer = middle
	allow_outside = yes
	movable = yes
	visible = "[GetVariableSystem.Exists( 'aeluran_order_window' )]"

	using = Window_Background
	using = Window_Decoration_Spike

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}

	vbox = {
		using = Window_Margins
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "AELURAN_ORDER_WINDOW_TITLE"
			}
			blockoverride "button_close" {
				onclick = "[GetVariableSystem.Clear( 'aeluran_order_window' )]"
			}
		}

		# Tabs
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 4 }
			spacing = 8

			button_standard = {
				size = { 180 36 }
				text = "AELURAN_ORDER_TAB_FLOCK"
				onclick = "[GetScriptedGui( 'aeluran_order_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Clear( 'aeluran_order_tab' )]"
			}
			button_standard = {
				size = { 180 36 }
				text = "AELURAN_ORDER_TAB_BLOODLINES"
				onclick = "[GetScriptedGui( 'aeluran_bl_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Set( 'aeluran_order_tab', 'bloodlines' )]"
			}
			button_standard = {
				size = { 180 36 }
				text = "AELURAN_ORDER_TAB_SISTERS"
				onclick = "[GetScriptedGui( 'aeluran_order_sisters_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetVariableSystem.Set( 'aeluran_order_tab', 'sisters' )]"
			}
			expand = {}
		}

		##########
		# Flock  #
		##########
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[Not( GetVariableSystem.Exists( 'aeluran_order_tab' ) )]"

			text_single = {
				layoutpolicy_horizontal = expanding
				margin = { 15 6 }
				text = "AELURAN_ORDER_FLOCK_PIETY"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content" {
					vbox = {
						name = "aeluran_order_flock_list"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList( 'aeluran_order_flock' )]"

						item = {
							widget = {
								size = { 560 96 }
								datacontext = "[Scope.GetCharacter]"

								background = {
									using = Background_Area
								}

								# The ruler
								portrait_head_small = {
									position = { 4 3 }
								}
								text_single = {
									position = { 100 10 }
									text = "[Character.GetShortUIName]"
									using = Font_Size_Medium
								}
								text_single = {
									position = { 100 38 }
									text = "[Character.GetPrimaryTitle.GetNameNoTooltip]"
								}
								text_single = {
									position = { 100 62 }
									text = "AELURAN_ORDER_ROW_DEVOTION"
								}

								# Her Red Sister, or an open post
								widget = {
									position = { 445 0 }
									size = { 110 96 }

									portrait_head_small = {
										position = { 10 3 }
										datacontext = "[Character.MakeScope.Var( 'religious_advisor' ).GetCharacter]"
										visible = "[Character.MakeScope.Var( 'religious_advisor' ).IsSet]"
									}

									button_standard = {
										parentanchor = center
										size = { 100 40 }
										text = "AELURAN_ORDER_ASSIGN"
										tooltip = "AELURAN_ORDER_ASSIGN_TT"
										visible = "[GetScriptedGui( 'aeluran_order_post_is_open' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
										onclick = "[GetScriptedGui( 'aeluran_order_open_appoint' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
									}

									text_single = {
										parentanchor = center
										text = "AELURAN_ORDER_NO_ADVISOR"
										visible = "[And( Not( Character.MakeScope.Var( 'religious_advisor' ).IsSet ), Not( GetScriptedGui( 'aeluran_order_post_is_open' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End ) ) )]"
									}
								}
							}
						}
					}
				}
			}
		}

		##############
		# Bloodlines #
		##############
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[GetVariableSystem.HasValue( 'aeluran_order_tab', 'bloodlines' )]"

			# The chosen pair and the proposal
			widget = {
				layoutpolicy_horizontal = expanding
				size = { 560 70 }

				background = {
					using = Background_Area_Dark
				}
				text_single = {
					position = { 12 8 }
					text = "AELURAN_BL_CHOOSE"
				}
				text_single = {
					position = { 12 30 }
					visible = "[GetPlayer.MakeScope.Var( 'aeluran_bl_first' ).IsSet]"
					text = "AELURAN_BL_FIRST"
				}
				text_single = {
					position = { 12 50 }
					visible = "[GetPlayer.MakeScope.Var( 'aeluran_bl_second' ).IsSet]"
					text = "AELURAN_BL_SECOND"
				}
				button_standard = {
					parentanchor = right|vcenter
					position = { -12 0 }
					size = { 150 44 }
					text = "AELURAN_BL_PROPOSE"
					enabled = "[GetScriptedGui( 'aeluran_bl_propose' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					tooltip = "[GetScriptedGui( 'aeluran_bl_propose' ).BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					onclick = "[GetScriptedGui( 'aeluran_bl_propose' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content" {
					vbox = {
						name = "aeluran_bloodlines_list"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList( 'aeluran_bloodlines' )]"

						item = {
							widget = {
								size = { 560 84 }
								datacontext = "[Scope.GetCharacter]"

								background = {
									using = Background_Area
								}
								background = {
									using = Background_Area_Light
									visible = "[GetScriptedGui( 'aeluran_bl_is_selected' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
								}

								portrait_head_small = {
									position = { 4 0 }
								}
								text_single = {
									position = { 100 8 }
									text = "[Character.GetShortUIName]"
									using = Font_Size_Medium
								}
								text_single = {
									position = { 100 36 }
									text = "AELURAN_BL_ROW_INFO"
								}
								text_single = {
									position = { 100 58 }
									text = "AELURAN_BL_ROW_WORTH"
								}

								button_standard = {
									parentanchor = right|vcenter
									position = { -12 0 }
									size = { 110 36 }
									text = "AELURAN_BL_SELECT"
									onclick = "[GetScriptedGui( 'aeluran_bl_select' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
								}
							}
						}
					}
				}
			}
		}
		###########
		# Sisters #
		###########
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[GetVariableSystem.HasValue( 'aeluran_order_tab', 'sisters' )]"

			# Wraps: a long single line would stretch the window past its frame
			text_multi = {
				margin = { 15 6 }
				autoresize = yes
				max_width = 590
				text = "AELURAN_ORDER_SISTERS_HEADER"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content" {
					vbox = {
						name = "aeluran_order_sisters_list"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList( 'aeluran_order_sisters' )]"

						item = {
							widget = {
								size = { 560 84 }
								datacontext = "[Scope.GetCharacter]"

								background = {
									using = Background_Area
								}

								portrait_head_small = {
									position = { 4 0 }
								}
								text_single = {
									position = { 100 8 }
									text = "[Character.GetShortUIName]"
									using = Font_Size_Medium
								}

								# What she sends her shepherd: her share of the temples she holds in lease
								text_single = {
									position = { 100 36 }
									visible = "[GreaterThan_int32( Character.GetNumTitlesFromTheocraticLease, '(int32)0' )]"
									text = "AELURAN_ORDER_SISTER_TITHE"
									tooltip = "CV_THEOCRACY_LESSEE_TOOLTIP"
								}
								text_single = {
									position = { 100 36 }
									visible = "[And( Not( GreaterThan_int32( Character.GetNumTitlesFromTheocraticLease, '(int32)0' ) ), Character.IsLandedRuler )]"
									text = "AELURAN_ORDER_SISTER_RULES"
								}
								text_single = {
									position = { 100 36 }
									visible = "[And( Not( GreaterThan_int32( Character.GetNumTitlesFromTheocraticLease, '(int32)0' ) ), Not( Character.IsLandedRuler ) )]"
									text = "AELURAN_ORDER_SISTER_NO_HOLDINGS"
								}

								# Where she serves
								text_single = {
									position = { 100 58 }
									visible = "[GetScriptedGui( 'aeluran_order_sister_is_advisor' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
									text = "AELURAN_ORDER_SISTER_ADVISES"
								}
								text_single = {
									position = { 100 58 }
									visible = "[And( Not( GetScriptedGui( 'aeluran_order_sister_is_advisor' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End ) ), Not( Character.IsLandedRuler ) )]"
									text = "AELURAN_ORDER_SISTER_LOCATION"
								}

								# Red Sister mark
								icon = {
									parentanchor = right|vcenter
									position = { -16 0 }
									size = { 52 52 }
									texture = "gfx/interface/icons/character_interactions/icon_aeluran_sister.dds"
									visible = "[GetScriptedGui( 'aeluran_order_sister_is_advisor' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
									tooltip = "AELURAN_ORDER_SISTER_ADVISOR_TT"
								}
							}
						}
					}
				}
			}
		}
	}
}
