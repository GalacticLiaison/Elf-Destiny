											tooltip = "AELURAN_BL_CHOOSE_BTN_TT"
											onclick = "[GetScriptedGui( 'aeluran_bl_choose' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
										}

										# Dynasty and house, as the Elf Finder shows them, right of the name and age: the dynasty shield, its name in the
										# flavour font, and the house shield and name beneath (none for the lowborn)
