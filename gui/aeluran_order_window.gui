												max_width = 150
												text = "[Character.GetShortUIName]"
												using = Font_Size_Medium
											}
										}
										text_single = {
											position = { 140 30 }
											max_width = 165
											text = "AELURAN_BL_ROW_INFO"
										}
										# The character's genetic and inheritable (elven bloodline) traits, packed in one row (a grid would keep the hidden non-genetic traits' slots as gaps;
										# the GUI cannot filter a list before laying it out)
										flowcontainer = {
											position = { 95 58 }
											datamodel = "[Character.GetTraitsForCharacter]"
											ignoreinvisible = yes
											spacing = 2
										
											item = {
												icon_trait = {
													visible = "[And( Trait.IsValid, Or( Trait.IsGenetic, Trait.IsInheritable ) )]"
										
