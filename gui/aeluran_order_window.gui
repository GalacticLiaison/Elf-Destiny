		###########
		# Sisters #
		###########
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			visible = "[GetVariableSystem.HasValue( 'aeluran_order_tab', 'sisters' )]"

			# Wraps: a long single line would stretch the window past its frame
			text_multi = {
				margin = { 15 6 }
				autoresize = yes
				max_width = 880
				text = "AELURAN_ORDER_SISTERS_HEADER"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content" {
					vbox = {
						name = "aeluran_order_sisters_list"
						layoutpolicy_horizontal = expanding
						datamodel = "[GetPlayer.MakeScope.GetList( 'aeluran_order_sisters' )]"

						item = {
							widget = {
								size = { 840 84 }
								datacontext = "[Scope.GetCharacter]"

								background = {
									using = Background_Area
								}

								portrait_head_small = {
									position = { 50 0 }
								}
								text_single = {
									position = { 146 8 }
									text = "[Character.GetShortUIName]"
									using = Font_Size_Medium
								}

								# What she sends her shepherd: her share of the temples she holds in lease
								text_single = {
									position = { 146 36 }
									visible = "[GreaterThan_int32( Character.GetNumTitlesFromTheocraticLease, '(int32)0' )]"
									text = "AELURAN_ORDER_SISTER_TITHE"
									tooltip = "CV_THEOCRACY_LESSEE_TOOLTIP"
								}
								text_single = {
									position = { 146 36 }
									visible = "[And( Not( GreaterThan_int32( Character.GetNumTitlesFromTheocraticLease, '(int32)0' ) ), Character.IsLandedRuler )]"
									text = "AELURAN_ORDER_SISTER_RULES"
								}
								text_single = {
									position = { 146 36 }
									visible = "[And( Not( GreaterThan_int32( Character.GetNumTitlesFromTheocraticLease, '(int32)0' ) ), Not( Character.IsLandedRuler ) )]"
									text = "AELURAN_ORDER_SISTER_NO_HOLDINGS"
								}

								# Where she serves
								text_single = {
									position = { 146 58 }
									visible = "[And( GetScriptedGui( 'aeluran_order_sister_is_advisor' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End ), Not( Character.MakeScope.Var( 'aeluran_whispers_for' ).IsSet ) )]"
									text = "AELURAN_ORDER_SISTER_ADVISES"
								}
								# On a Gather Whispers mission
								text_single = {
									position = { 146 58 }
									visible = "[Character.MakeScope.Var( 'aeluran_whispers_for' ).IsSet]"
									text = "AELURAN_ORDER_SISTER_WHISPERING"
								}
								text_single = {
									position = { 146 58 }
									visible = "[And( Not( GetScriptedGui( 'aeluran_order_sister_is_advisor' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End ) ), Not( Character.IsLandedRuler ) )]"
									text = "AELURAN_ORDER_SISTER_LOCATION"
								}

								# Gather Whispers: set her to spy on her ruler's court (aeluran_gather_whispers_interaction)
								button_round = {
									parentanchor = right|vcenter
									position = { -84 0 }
									visible = "[GetScriptedGui( 'aeluran_order_sister_is_advisor' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
									enabled = "[Not( Character.MakeScope.Var( 'aeluran_whispers_for' ).IsSet )]"
									tooltip = "AELURAN_ORDER_WHISPERS_TT"
									onclick = "[GetScriptedGui( 'aeluran_order_open_whispers' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"

									icon = {
										alwaystransparent = yes
										parentanchor = center
										size = { 34 34 }
										texture = "gfx/interface/icons/council_task_types/task_find_secrets.dds"
									}
								}

								# Religious interactions with the Sister (vanilla type, gui/window_faith.gui)
								button_interactions_religion = {
									parentanchor = left|vcenter
									position = { 4 0 }
								}

								# Red Sister mark
								icon = {
									parentanchor = right|vcenter
									position = { -16 0 }
									size = { 52 52 }
									texture = "gfx/interface/icons/character_interactions/icon_aeluran_sister.dds"
									visible = "[GetScriptedGui( 'aeluran_order_sister_is_advisor' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Character.MakeScope ).End )]"
									tooltip = "AELURAN_ORDER_SISTER_ADVISOR_TT"
								}
