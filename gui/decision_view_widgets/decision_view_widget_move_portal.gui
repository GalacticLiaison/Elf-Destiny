# Decision view widget to create a holy order
# Required controller: create_holy_order

flowcontainer = {
	name = "decision_view_widget_move_portal"
	direction = vertical
	minimumsize = { 514 -1 }
	maximumsize = { 514 -1 }
	ignoreinvisible = yes
	margin_top = 15

	flowcontainer = {
		direction = horizontal
		ignoreinvisible = yes
		parentanchor = hcenter

		text_single = {
			visible = "[And(DecisionViewWidgetSelectBarony.IsCreate, DecisionViewWidgetSelectBarony.HasCurrentTitle)]"
			parentanchor = vcenter
			fontsize_min = 14
			text = "TRANSPORT_THE_GRAND_PORTAL_DECISION_DESTINATION_LABEL"
		}

		spacer = {
			size = { 5 5 }
		}

		text_single = {
			visible = "[DecisionViewWidgetSelectBarony.HasCurrentTitle]"
			parentanchor = vcenter
			fontsize_min = 14
			default_format = "#high"
			text = "[DecisionViewWidgetSelectBarony.GetCurrentTitle.GetNameNoTier]"
		}

		widget = { size = { 15 0 } }

		button_standard = {
			name = "change_capital"
			minimumsize = { 200 0 }

			onclick = "[DecisionViewWidgetSelectBarony.OnSelectCapital]"
			onclick = "[GetVariableSystem.Toggle('move_portal')]"
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
			enabled = "[DecisionViewWidgetSelectBarony.HasValidTitles]"
			tooltip = "LEASE_OUT_BARONIES_TOOLTIP"

			text_single = {
				visible = "[And(DecisionViewWidgetSelectBarony.IsCreate, DecisionViewWidgetSelectBarony.HasCurrentTitle)]"
				text = "TRANSPORT_THE_GRAND_PORTAL_DECISION_SELECT_DESTINATION"
				parentanchor = left|vcenter
				align = nobaseline
				position = { 10 0 }
				fontsize_min = 14
			}

			button_change = {
				visible = "[DecisionViewWidgetSelectBarony.HasCurrentTitle]"
				parentanchor = right|vcenter
				position = { -5 0 }
				alwaystransparent = yes
				size = { 25 25 }
			}

			button_select_arrow = {
				visible = "[Not(DecisionViewWidgetSelectBarony.HasCurrentTitle)]"
				parentanchor = right|vcenter
				position = { -5 0 }
				alwaystransparent = yes
				size = { 25 25 }
			}
		}
	}
}