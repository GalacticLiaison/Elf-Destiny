# The Order window's button, above the faith button (bottom left). Shown to a Matron holding a Matronate and to the
# High Matriarch. Opens gui/aeluran_order_window.gui.
widget = {
	name = "aeluran_order_button"
	parentanchor = bottom|left
	widgetanchor = bottom|left
	position = { 12 -300 }
	size = { 56 56 }
	layer = bottom
	# Hidden for Beta_v2.0.4: the Order (flock) window is not ready for players. Put the line below back to show it.
	# visible = "[GetScriptedGui( 'aeluran_order_is_shepherd' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	visible = no

	# Opening: refresh the lists, show the Matronates map mode and pan to her Matronate (var:aeluran_order_focus,
	# see aeluran_order_set_focus_effect). Pans rather than zooms: a zoom goes close enough that map modes fade out.
	button = {
		name = "aeluran_order_open"
		size = { 56 56 }
		texture = "gfx/interface/icons/traits/aeluran_matron.dds"
		tooltip = "AELURAN_ORDER_BUTTON_TT"
		visible = "[Not( GetVariableSystem.Exists( 'aeluran_order_window' ) )]"
		onclick = "[GetScriptedGui( 'aeluran_order_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[GetScriptedGui( 'aeluran_bl_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		onclick = "[GetScriptedGui( 'aeluran_order_sisters_refresh' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		# The vanilla clerical-regions map colours the Matronates. From 2026-10-02 to 2026-10-04 this opened the Aeluran
		# Order situation's view instead (its own Matronate colours); the situation is dormant now, see
		# common/situation/situations/elf_dest_matronate_map_situation.txt. To bring it back:
		# onclick = "[OpenGameViewData( GetSituation( 'aeluran_matronate_map' ).GetWindowName, GetSituation( 'aeluran_matronate_map' ).GetID )]"
		onclick = "[SetMapMode( 'clerical_regions' )]"
		onclick = "[GetPlayer.MakeScope.Var( 'aeluran_order_focus' ).GetProvince.PanCameraTo]"
		onclick = "[GetVariableSystem.Set( 'aeluran_order_window', 'open' )]"
	}

	# Closing
	button = {
		name = "aeluran_order_close"
		size = { 56 56 }
		texture = "gfx/interface/icons/traits/aeluran_matron.dds"
		tooltip = "AELURAN_ORDER_BUTTON_TT"
		visible = "[GetVariableSystem.Exists( 'aeluran_order_window' )]"
		onclick = "[GetVariableSystem.Clear( 'aeluran_order_window' )]"
	}
}
